generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  service   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([service])
  @@index([status])
  @@index([createdAt])
}